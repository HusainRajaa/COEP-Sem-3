/Type /StructElem
/S /H1
/T (#include <stdio.h> float pi = 3.14; void square\(\) {     pi = pi * pi; } int main\(\) {  printf\("The initial value of the variable pi is: %f \\n", pi\);     pi++;      printf\("Value of pi updated using main\(\) function is: %f \\n", pi\);     square\(\);     printf\("Value of pi updated using square\(\) function is: %f", pi\);     return 0; })
/E (#include <stdio.h> float pi = 3.14; void square\(\) {     pi = pi * pi; } int main\(\) {  printf\("The initial value of the variable pi is: %f \\n", pi\);     pi++;      printf\("Value of pi updated using main\(\) function is: %f \\n", pi\);     square\(\);     printf\("Value of pi updated using square\(\) function is: %f", pi\);     return 0; })
/Alt ()
/Pg 12 0 R
/K [0]
>>
endobj
168 0 obj
<<
/Type /StructElem
/S /H1
/T (output : The initial value of the variable pi is: 3.140000  Value of pi updated using main\(\) function is: 4.140000  Value of pi updated using square\(\) function is: 17.139603)
/E (output : The initial value of the variable pi is: 3.140000  Value of pi updated using main\(\) function is: 4.140000  Value of pi updated using square\(\) function is: 17.139603)
/Alt ()
/Pg 13 0 R
/K [0]
>>
