204 0 obj
<<
/Type /StructElem
/S /H1
/T (Access Global Variable if there is a Local Variable with Same Name in C?)
/E (Access Global Variable if there is a Local Variable with Same Name in C?)
/Alt ()
/Pg 22 0 R
/K [0]
>>
endobj
205 0 obj
<<
/Type /StructElem
/S /P
/P 278 0 R
/ActualText (local variables have higher precedence \(priority\) than global variables. So, if there is a local variable with the same name as a global variable, we will get access to the local variable when we call the variable name.)
/Alt ()
/Pg 22 0 R
/K [1]
>>
endobj
206 0 obj
<<
/Type /StructElem
/S /P
/P 279 0 R
/ActualText (We use the' extern' keyword to access the global variable if there is a local variable with the same name. The keyword extern stands for external or we could also use :: scope resolution operator to use global variables.)
/Alt ()
/Pg 22 0 R
/K [2]
>>
endobj
207 0 obj
<<
/Type /StructElem
/S /H1
/T (#include <stdio.h int var = 3;  void func\(\) {     // declaring a local variable     int var = 70;     )
/E (#include <stdio.h int var = 3;  void func\(\) {     // declaring a local variable     int var = 70;     )
/Alt ()
/Pg 23 0 R
/K [0]
>>
endobj
208 0 obj
<<
/Type /StructElem
/S /H1
/T (    printf\("The value of local var is: %d \\n", var\);    {       extern int var;          printf\("The value of global var using extern keyword is: %d \\n", var\);     }     )
/E (    printf\("The value of local var is: %d \\n", var\);    {       extern int var;          printf\("The value of global var using extern keyword is: %d \\n", var\);     }     )
/Alt ()
/Pg 23 0 R
/K [1]
>>
endobj
209 0 obj
<<
/Type /StructElem
/S /H1
/T (     printf\("The value of global var using Scope resolution operator is: %d \\n", ::var\); })
/E (     printf\("The value of global var using Scope resolution operator is: %d \\n", ::var\); })
/Alt ()
/Pg 23 0 R
/K [2]
>>
endobj
